#!/bin/bash
# Moteur Whisper CPU de Myna, équivalent de whisper-snap/engines/cpu/server
# lancé par `modelctl run` dans le snap. Lancé par myna-whisper.service ;
# réglages par variables d'environnement (voir
# /usr/share/doc/myna-whisper/examples/whisper.conf).
set -euo pipefail

lib=/usr/lib/myna-whisper/site-packages
models=/usr/share/myna-whisper/models

size="${MYNA_WHISPER_MODEL:-base}"
yaml="$models/$size/model.yaml"
[ -f "$yaml" ] || { echo "myna-whisper: modèle inconnu : $size" >&2; exit 2; }
model_dir="${XDG_DATA_HOME:-$HOME/.local/share}/myna/models/$size"
if [ ! -f "$model_dir/model.bin" ]; then
    echo "myna-whisper: modèle absent : $model_dir" >&2
    echo "myna-whisper: le télécharger avec : myna-whisper-fetch-model $size" >&2
    exit 1
fi
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR non défini}"

# Variables MODEL_* du model.yaml, comme modelctl les exporte.
model_env() { sed -n "s/^  - $1=//p" "$yaml" | head -n1; }

compute_type="${MYNA_WHISPER_COMPUTE_TYPE:-auto}"
if [ "$compute_type" = auto ]; then
    compute_type="$(model_env MODEL_COMPUTE_TYPE)"
    compute_type="${compute_type:-default}"
fi

args=()
[ "${MYNA_WHISPER_STREAMING:-false}" = true ] && args+=(--streaming)
[ "$(model_env MODEL_BATCH_CONDITION_ON_PREVIOUS_TEXT)" = false ] &&
    args+=(--no-batch-condition-on-previous-text)
[ "$(model_env MODEL_BATCH_VAD_FILTER)" = true ] && args+=(--batch-vad-filter)

# --share-provider écrit provider.env (lu par myna-desktop) à partir de
# l'identité du snap, qu'on fournit ici.
export SNAP_NAME=myna-whisper SNAP_INSTANCE_NAME=myna-whisper
export PYTHONPATH="$lib"
# Pas de bytecode écrit dans /usr/lib (lecture seule pour l'utilisateur).
export PYTHONDONTWRITEBYTECODE=1

exec /usr/bin/python3 -s -m myna.server \
    --socket "$XDG_RUNTIME_DIR/myna/whisper/myna.sock" \
    --share-provider \
    --model "$model_dir" \
    --device cpu \
    --compute-type "$compute_type" \
    --sleep-idle-seconds "${MYNA_WHISPER_IDLE:-300}" \
    --idle-action unload \
    "${args[@]}" \
    "$@"
